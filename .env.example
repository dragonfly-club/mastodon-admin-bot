TELEGRAM_BOT_TOKEN=123456:replace-me
# Optional. Leave unset to use https://api.telegram.org.
# TELEGRAM_API_BASE_URL=http://localhost:8081
BIND_HOST=127.0.0.1
BIND_PORT=8080

MASTODON_BASE_URL=https://mast.dragon-fly.club
MASTODON_WEBHOOK_SECRET=replace-me
MASTODON_CLIENT_ID=replace-me
MASTODON_CLIENT_SECRET=replace-me
MASTODON_REDIRECT_URI=https://bot.mast.dragon-fly.club/oauth/callback
MASTODON_SCOPES=profile admin:read:accounts admin:write:accounts admin:read:reports admin:write:reports

TRUSTED_TELEGRAM_USER_IDS=111111,222222
TELEGRAM_HOME_CHAT_IDS=-1001234567890
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-me

# Default auto-reject timeout (seconds) for autoban-matched pending accounts when
# no value has been set via /autobantimeout. Default: 43200 (12h).
# AUTOBAN_DEFAULT_REJECT_AFTER_SECONDS=43200

# Delete handled registration snapshots and stale operational records after this many days.
# DATA_RETENTION_DAYS=30

# Prefix lengths used to anonymize addresses before external IP geolocation lookup.
# Defaults: IPv4 /24 and IPv6 /80.
# IP_LOOKUP_IPV4_PREFIX_LENGTH=24
# IP_LOOKUP_IPV6_PREFIX_LENGTH=80
